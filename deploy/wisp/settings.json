{
  "$type": "place.wisp.settings",
  "headers": [
    {
      "name": "Content-Security-Policy",
      "value": "frame-ancestors 'self'"
    },
    { "name": "X-Content-Type-Options", "value": "nosniff" },
    {
      "name": "Referrer-Policy",
      "value": "strict-origin-when-cross-origin"
    },
    {
      "name": "Strict-Transport-Security",
      "value": "max-age=31536000"
    },
    {
      "name": "Permissions-Policy",
      "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=(), midi=(), display-capture=(), browsing-topics=()"
    },
    { "name": "Cache-Control", "value": "no-cache", "path": "*.html" },
    {
      "name": "Cache-Control",
      "value": "public, max-age=31536000, immutable",
      "path": "/js/*"
    },
    {
      "name": "Cache-Control",
      "value": "public, max-age=31536000, immutable",
      "path": "/css/*"
    },
    {
      "name": "Cache-Control",
      "value": "public, max-age=31536000, immutable",
      "path": "/plugin-sdk/*"
    },
    { "name": "Cache-Control", "value": "no-store", "path": "/not-found.txt" }
  ]
}
