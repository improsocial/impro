{
  "name": "impro",
  "version": "0.18.213",
  "type": "module",
  "scripts": {
    "start": "rm -rf \"${BUILD_DIR:-build}\" && NODE_ENV=development eleventy --serve",
    "start:tunnel": "node scripts/dev-tunnel.js",
    "build": "rm -rf \"${BUILD_DIR:-build}\" && NODE_ENV=production eleventy",
    "bundle:capacitor": "esbuild ./clientLibs/capacitor.js --bundle --format=esm --outfile=src/js/lib/capacitor.js",
    "ios": "npm run build && cap sync && NODE_ENV=development cap run ios",
    "bundle:lit-html": "esbuild ./clientLibs/litHtml.js --bundle --format=esm --outfile=src/js/lib/lit-html.js",
    "format": "pretty-quick --staged",
    "format:all": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "node scripts/node-test-parallel.js --workers=4 --import=./tests/unit/env.js --test-force-exit --test-reporter=./tests/unit/testReporter.js 'tests/unit/specs/**/*.test.js'",
    "test:unit:coverage": "node --import ./tests/unit/env.js --test-isolation=none --test-force-exit --experimental-test-coverage --test-coverage-include='src/js/**' --test 'tests/unit/specs/**/*.test.js'",
    "test:e2e": "npx playwright test",
    "test:visual": "VISUAL_CAPTURE_DIR=tests/.artifacts/visual npx playwright test tests/e2e/specs/views",
    "serve:static": "node scripts/serve-static.js",
    "prepare": "husky"
  },
  "workspaces": [
    "impro-plugin"
  ],
  "license": "0BSD",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@capacitor/cli": "^7.0.0",
    "@import-maps/resolve": "^2.0.0",
    "@playwright/test": "^1.60.0",
    "canvas": "^3.2.3",
    "dotenv": "^17.2.2",
    "es-module-lexer": "^1.4.1",
    "esbuild": "^0.25.10",
    "htmlparser2": "^9.0.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^27.0.0",
    "native-run": "^2.0.1",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "lit-html": "3.3.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
